rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Global Helpers ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isVerified() && (
        request.auth.token.email == 'rituparno.tnts@gmail.com'
        || request.auth.token.email == 'frankfufeng@gmail.com'
        || exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isStringBounded(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function isStringListBounded(listVal, maxItems) {
      return listVal is list
        && listVal.size() <= maxItems
        && (listVal.size() == 0 || listVal[0] is string);
    }

    // --- Validation Blueprints ---
    function isValidProperty(data) {
      return data.keys().hasAll([
          'slug', 'title', 'description', 'price', 'listingType', 'propertyType',
          'status', 'featured', 'published', 'address', 'city', 'bedrooms',
          'bathrooms', 'sqft', 'imageUrls', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'slug', 'title', 'description', 'price', 'listingType', 'propertyType',
          'status', 'featured', 'published', 'address', 'city', 'neighborhood',
          'bedrooms', 'bathrooms', 'sqft', 'yearBuilt', 'parking', 'features',
          'imageUrls', 'imageAlts', 'lat', 'lng', 'seoTitle', 'seoDescription',
          'createdAt', 'updatedAt'
        ])
        && isStringBounded(data.slug, 2, 140)
        && data.slug.matches('^[a-z0-9\\-]+$')
        && isStringBounded(data.title, 2, 160)
        && isStringBounded(data.description, 1, 6000)
        && data.price is number && data.price >= 0 && data.price <= 1000000000
        && data.listingType in ['Sale', 'Rent']
        && data.propertyType in ['House', 'Condo', 'Luxury', 'Townhouse', 'Commercial', 'Investment']
        && data.status in ['For Sale', 'For Rent', 'Sold', 'Pending']
        && data.featured is bool
        && data.published is bool
        && isStringBounded(data.address, 2, 240)
        && isStringBounded(data.city, 1, 100)
        && (!('neighborhood' in data) || isStringBounded(data.neighborhood, 0, 100))
        && data.bedrooms is number && data.bedrooms >= 0 && data.bedrooms <= 50
        && data.bathrooms is number && data.bathrooms >= 0 && data.bathrooms <= 50
        && data.sqft is number && data.sqft >= 0 && data.sqft <= 1000000
        && (!('yearBuilt' in data) || (data.yearBuilt is number && data.yearBuilt >= 0 && data.yearBuilt <= 2100))
        && (!('parking' in data) || isStringBounded(data.parking, 0, 120))
        && (!('features' in data) || isStringListBounded(data.features, 30))
        && isStringListBounded(data.imageUrls, 15)
        && (!('imageAlts' in data) || isStringListBounded(data.imageAlts, 15))
        && (!('lat' in data) || (data.lat is number && data.lat >= -90 && data.lat <= 90))
        && (!('lng' in data) || (data.lng is number && data.lng >= -180 && data.lng <= 180))
        && (!('seoTitle' in data) || isStringBounded(data.seoTitle, 0, 140))
        && (!('seoDescription' in data) || isStringBounded(data.seoDescription, 0, 300))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidInquiry(data) {
      return data.keys().hasAll([
          'name', 'email', 'phone', 'inquiryType', 'message', 'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'name', 'email', 'phone', 'propertyId', 'propertyTitle', 'propertyAddress',
          'propertyType', 'inquiryType', 'subject', 'message', 'status', 'createdAt', 'updatedAt'
        ])
        && isStringBounded(data.name, 1, 120)
        && isStringBounded(data.email, 3, 160)
        && isStringBounded(data.phone, 5, 40)
        && (!('propertyId' in data) || isStringBounded(data.propertyId, 0, 128))
        && (!('propertyTitle' in data) || isStringBounded(data.propertyTitle, 0, 180))
        && (!('propertyAddress' in data) || isStringBounded(data.propertyAddress, 0, 240))
        && (!('propertyType' in data) || isStringBounded(data.propertyType, 0, 60))
        && data.inquiryType in ['Property Info', 'Schedule Viewing', 'Availability', 'Property Valuation', 'General Contact']
        && (!('subject' in data) || isStringBounded(data.subject, 0, 180))
        && isStringBounded(data.message, 1, 3000)
        && data.status in ['new', 'contacted', 'completed']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTestimonial(data) {
      return data.keys().hasAll([
          'clientName', 'clientRole', 'rating', 'quote', 'isPlaceholder', 'published', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'clientName', 'clientRole', 'rating', 'quote', 'isPlaceholder', 'published', 'sortOrder', 'createdAt', 'updatedAt'
        ])
        && isStringBounded(data.clientName, 1, 100)
        && isStringBounded(data.clientRole, 1, 120)
        && data.rating is number && data.rating >= 1 && data.rating <= 5
        && isStringBounded(data.quote, 5, 1000)
        && data.isPlaceholder is bool
        && data.published is bool
        && (!('sortOrder' in data) || (data.sortOrder is number && data.sortOrder >= 0 && data.sortOrder <= 10000))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSiteConfig(data) {
      return data.keys().hasAll(['configType', 'payload', 'updatedAt'])
        && data.keys().hasOnly(['configType', 'payload', 'updatedAt'])
        && data.configType in ['general', 'content', 'seo', 'navigation']
        && data.payload is map
        && data.updatedAt is timestamp;
    }

    function isValidMediaAsset(data) {
      return data.keys().hasAll(['name', 'url', 'category', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['name', 'url', 'storagePath', 'alt', 'category', 'createdAt', 'updatedAt'])
        && isStringBounded(data.name, 1, 160)
        && isStringBounded(data.url, 1, 1000)
        && (!('storagePath' in data) || isStringBounded(data.storagePath, 0, 400))
        && (!('alt' in data) || isStringBounded(data.alt, 0, 240))
        && data.category in ['property', 'banner', 'portrait', 'brand']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAdminUser(data) {
      return data.keys().hasAll(['email', 'addedAt'])
        && data.keys().hasOnly(['email', 'addedAt'])
        && isStringBounded(data.email, 3, 160)
        && data.addedAt is timestamp;
    }

    // --- Collection Rules ---

    // Connection check document
    match /test/connection {
      allow get: if true;
      allow list, write: if false;
    }

    // Properties: Published visible publicly, unpublished admin-only
    match /properties/{propertyId} {
      allow get: if isValidId(propertyId) && (existing().published == true || isAdmin());
      allow list: if existing().published == true || isAdmin();
      allow create: if isAdmin()
        && isValidId(propertyId)
        && isValidProperty(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidId(propertyId)
        && isValidProperty(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(propertyId);
    }

    // Inquiries: Public write-only dropbox (status must be 'new'), Admin-only read/manage
    match /inquiries/{inquiryId} {
      allow get: if isValidId(inquiryId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isValidId(inquiryId)
        && isValidInquiry(incoming())
        && incoming().status == 'new'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidId(inquiryId)
        && isValidInquiry(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(inquiryId);
    }

    // Testimonials: Published visible publicly, admin manages
    match /testimonials/{testimonialId} {
      allow get: if isValidId(testimonialId) && (existing().published == true || isAdmin());
      allow list: if existing().published == true || isAdmin();
      allow create: if isAdmin()
        && isValidId(testimonialId)
        && isValidTestimonial(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidId(testimonialId)
        && isValidTestimonial(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(testimonialId);
    }

    // Site Config (CMS / Settings / SEO / Navigation): Public read, Admin write
    match /siteConfig/{configId} {
      allow get: if isValidId(configId) && configId in ['general', 'content', 'seo', 'navigation'];
      allow list: if existing().configType in ['general', 'content', 'seo', 'navigation'];
      allow create, update: if isAdmin()
        && isValidId(configId)
        && configId in ['general', 'content', 'seo', 'navigation']
        && isValidSiteConfig(incoming())
        && incoming().configType == configId
        && incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(configId);
    }

    // Media Asset Registry: Admin-only
    match /media/{mediaId} {
      allow get: if isValidId(mediaId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin()
        && isValidId(mediaId)
        && isValidMediaAsset(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidId(mediaId)
        && isValidMediaAsset(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(mediaId);
    }

    // Admins registry
    match /admins/{adminUid} {
      allow get: if isValidId(adminUid) && isVerified() && (request.auth.uid == adminUid || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isAdmin()
        && isValidId(adminUid)
        && isValidAdminUser(incoming())
        && incoming().addedAt == request.time;
      allow delete: if isAdmin() && isValidId(adminUid);
    }
  }
}
